# Copy to .env.local to try these settings locally. All variables are read at build time.
# Umami site id (UUID). Left empty: the Umami script is not loaded at all.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Optional: script URL of a self-hosted Umami. Default: https://cloud.umami.is/script.js
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
# Donation page behind "Offrir un café" (for instance a Buy Me a Coffee page).
# Left empty: the button is shown but inactive.
NEXT_PUBLIC_DONATION_URL=
